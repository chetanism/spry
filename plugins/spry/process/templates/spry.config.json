{
  "spry": "0.58.0",
  "spry_baseline": "CH-69",
  "product": "<product name>",
  "levels": ["milestone", "epic", "feature", "story"],
  "ids": {
    "milestone": "M", "epic": "E", "feature": "F", "story": "S",
    "slice": "SL", "task": "T", "bug": "B", "decision": "D"
  },
  "team": {
    "members": [],
    "review": {}
  },
  "budgets": {
    "AGENTS.md": 150,
    "spry/knowledge/**": 120,
    "spry/plan/**/README.md": 150,
    "spry/plan/**/SL-*.md": 200
  },
  "glossary": "spry/knowledge/glossary.md",
  "always_check": [
    "spry/knowledge/security.md",
    "spry/knowledge/performance.md",
    "spry/knowledge/decisions/INDEX.md"
  ],
  "checks": {
    "fast": [
      {"name": "format", "run": "<formatter in check mode>", "fix": "<formatter in write mode> {files}"},
      {"name": "lint", "run": "<linter, with its cache>"},
      {"name": "types", "run": "<type checker, if the language has one>"}
    ],
    "docs": ["spry/**", "**/*.md"],
    "generated": [],
    "lock": false
  },
  "tests": {
    "match": ["<glob of test files, e.g. **/*.test.ts>"],
    "affected": "<command that runs only tests affected by the working tree>",
    "retry": "",
    "always": [],
    "all": "<command that runs every test, in parallel>",
    "junit": "<path the runner writes JUnit XML to>",
    "parts": [
      {"name": "unit", "run": "<command>", "stack": false},
      {"name": "integration", "run": "<command>", "stack": true}
    ]
  },
  "stack": {
    "running": "<command that exits 0 when the local services are up>",
    "up": "<command that starts them and waits until healthy>",
    "down": "<command that stops them, keeping their data>"
  },
  "explore": {
    "env": "<file sourced in every shell: ports and data apart from the development instance>",
    "up": "<command that starts the isolated instance; --fresh resets its data>",
    "down": "<command that stops it>",
    "fixture": "<command or script that creates the starting data — two of everything with a boundary>"
  },
  "falsify": {
    "parallel": false,
    "timeout": 600,
    "share": [],
    "keep_worktrees": true,
    "setup": "",
    "controls": "guards",
    "runners": [
      {"match": ["<glob of test files>"], "cwd": "package", "command": "<runner with fail-fast flag> {files}"}
    ]
  },
  "pace": {
    "away": 30,
    "logs": [],
    "flags": {"falsify_share": 0.2, "session_share": 0.2, "merge_wait_share": 0.5, "review_agents": 3},
    "token_weights": {"input": 1, "cache_read": 0.1, "cache_write_5m": 1.25, "cache_write_1h": 2, "output": 5},
    "buckets": [300, 700, 1300, 2500]
  },
  "hooks": {
    "session": true,
    "link_fields": true,
    "cited_criteria": true,
    "check_edit": true,
    "merge": true,
    "check_stop": true,
    "step_commit": true,
    "session_end": true
  },
  "memory": {"index_lines": 60, "index_bytes": 8000, "line_chars": 200, "stale_days": 30},
  "slices": {
    "pick": "offer",
    "mode": "split",
    "design_review": false,
    "steps": {"max": 5, "max_lines": 800, "step_lines": 0, "tests": false, "tests_skip": []}
  },
  "worktrees": {
    "dir": ".claude/worktrees",
    "home_branch": "alt{index}",
    "max": 4,
    "setup": "",
    "share": [],
    "stale_after": 12
  },
  "progress": {"transcripts": false, "quiet": 15, "keep": 400},
  "main_branch": "main",
  "mint": "local"
}
